# See https://help.github.com/articles/ignoring-files/ for more information.

# ── Dependencies ─────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Testing / coverage ───────────────────────────────────────
/coverage

# ── Next.js ──────────────────────────────────────────────────
/.next/
/out/

# ── Production build ─────────────────────────────────────────
/build

# ── Environment files — NEVER commit these ───────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── macOS ────────────────────────────────────────────────────
.DS_Store
*.pem

# ── Debug logs ───────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Vercel / deployment ──────────────────────────────────────
.vercel

# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ── Data cache ───────────────────────────────────────────────
/data/

# ── Static export / tooling (optional) ───────────────────────
/out/

# ── Editor / IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
