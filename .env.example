# ============================================================
# Environment Variables - Copy this file to .env.local
# and fill in your own values. NEVER commit .env.local!
# ============================================================

# ── AI / LLM ────────────────────────────────────────────────
# Google Gemini API key (used to generate domain name suggestions)
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Domain availability (optional enhancements) ─────────────
# Default checks use DNS + WHOIS in src/lib/namecheap.ts.
# For faster/more accurate checks you can set ONE of:
#
# RapidAPI Domainr (see RapidAPI dashboard for key)
# RAPIDAPI_KEY=
#
# Namecheap API (production or sandbox)
# NAMECHEAP_API_KEY=
# NAMECHEAP_API_USER=
# NAMECHEAP_CLIENT_IP=
# NAMECHEAP_USERNAME=
# NEXT_PUBLIC_NAMECHEAP_ENVIRONMENT=sandbox
