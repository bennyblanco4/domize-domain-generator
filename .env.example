# ============================================================
# Environment Variables - Copy this file to .env.local
# and fill in your own values. NEVER commit .env.local!
# ============================================================

# ── AI / LLM ────────────────────────────────────────────────
# Google Gemini API key (used to generate domain name suggestions)
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Domain availability (optional enhancement) ──────────────
# Default checks use DNS + WHOIS.
# For faster/more accurate checks you can set:
#
# RapidAPI Domainr (see RapidAPI dashboard for key)
# RAPIDAPI_KEY=
